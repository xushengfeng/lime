{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "启动服务器",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["exec", "tsx", "src/server/start.ts"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
